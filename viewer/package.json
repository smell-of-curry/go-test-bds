{
  "name": "@go-test-bds/viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:capture": "esbuild capture/cli.ts --bundle --platform=node --format=cjs --outfile=dist-capture/cli.cjs --external:playwright",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:capture": "tsx --test capture/*.test.ts",
    "generate:fixture": "tsx testdata/generate.ts",
    "diagnose:terrain": "node tools/diagnose-terrain-packs.mjs",
    "test:golden": "playwright test --project=golden"
  },
  "dependencies": {
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.172.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
