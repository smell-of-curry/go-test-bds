{
  "namespace": "player_ping",

  "main": {
    "type": "image",
    "size": ["100%c + 6px", "100%c + 2px"],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "content": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": ["100%c", "10px"],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "controls": [
            {
              "label_prefix": {
                "type": "label",
                "size": ["default", "default"],
                "text": "phud.playerPing.label",
                "localize": true,
                "enable_profanity_filter": false,
                "color": "$chat_text_color",
                "shadow": true
              }
            },
            {
              "value_text": {
                "type": "label",
                "size": ["default", "default"],
                "text": "#text",
                "localize": false,
                "enable_profanity_filter": false,
                "color": "$chat_text_color",
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#player_ping_text",
                    "binding_type": "view",
                    "source_control_name": "elements",
                    "source_property_name": "(#player_ping_text - '_')",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#null",
        "binding_type": "view",
        "source_control_name": "elements",
        "source_property_name": "#player_ping_text",
        "target_property_name": "#player_ping_text"
      },
      {
        "binding_name": "#null",
        "binding_type": "view",
        "source_property_name": "(not (#player_ping_text = ''))",
        "target_property_name": "#visible"
      },
      {
        "binding_name": "#null",
        "binding_type": "view",
        "source_property_name": "(not (#player_ping_text = ''))",
        "target_property_name": "#enabled"
      },
      {
        "binding_name": "#hud_text_background_alpha",
        "binding_name_override": "#alpha"
      }
    ]
  }
}
